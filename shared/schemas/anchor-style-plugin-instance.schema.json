{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livecompanion.local/schemas/anchor-style-plugin-instance.schema.json",
  "title": "Anchor Style Plugin Instance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "instance_id",
    "plugin_id",
    "plugin_version",
    "enabled",
    "strength"
  ],
  "properties": {
    "api_version": { "const": "anchor-style-plugin-instance/v1" },
    "instance_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "plugin_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "plugin_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "enabled": { "type": "boolean" },
    "strength": { "type": "integer", "minimum": 0, "maximum": 100 },
    "parameters": { "type": "object", "default": {} }
  }
}
