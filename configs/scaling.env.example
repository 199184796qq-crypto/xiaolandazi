# Single Core node target: 100 actively monitored rooms
# Room activity persistence is throttled to avoid one MySQL UPDATE per public event.
COLLECTOR_WORKERS=5
COLLECTOR_ROOMS_PER_WORKER=20
PUBLIC_EVENT_LOG_ENABLED=false
MEDIA_MAX_SESSIONS=8
CORE_DB_MAX_OPEN_CONNS=40
CORE_DB_MAX_IDLE_CONNS=10

# Management runtime settlement: batch room-state lookup + parallel workers
LIVE_RUNTIME_RECONCILE_BATCH=500
LIVE_RUNTIME_RECONCILE_WORKERS=16
MGMT_DB_MAX_OPEN_CONNS=30
MGMT_DB_MAX_IDLE_CONNS=10

# Single-node defaults
CORE_NODE_ID=core-0
CORE_SHARD_INDEX=0
CORE_SHARD_COUNT=1
CORE_ROOM_LEASE_ENABLED=true
CORE_ROOM_LEASE_TTL_SECONDS=15
CORE_ROOM_LEASE_RENEW_SECONDS=5
CORE_ROOM_FAILOVER_DELAY_SECONDS=3
CORE_BASE_URL=http://127.0.0.1:8081

# Only one Management instance runs background reconciliation at a time.
# Give every Management replica a unique MGMT_NODE_ID.
MGMT_NODE_ID=management-0
MGMT_RECONCILE_LEADER_TTL_SECONDS=15

# Multi-node example (same shared MySQL + Redis on every Core node):
# Management:
# CORE_BASE_URLS=http://core-0:8081,http://core-1:8081,http://core-2:8081
# Core node 0:
# CORE_NODE_ID=core-0
# CORE_SHARD_INDEX=0
# CORE_SHARD_COUNT=3
# Core node 1:
# CORE_NODE_ID=core-1
# CORE_SHARD_INDEX=1
# CORE_SHARD_COUNT=3
# Core node 2:
# CORE_NODE_ID=core-2
# CORE_SHARD_INDEX=2
# CORE_SHARD_COUNT=3
# IMPORTANT: CORE_BASE_URLS order must match CORE_SHARD_INDEX order.
# Static shard ownership is preferred placement. Redis room leases are the
# runtime authority and allow a healthy Core node to take over after lease TTL.

# Capacity planning: size MySQL max_connections above the combined pool ceilings
# of all Core nodes plus Management, with headroom for migrations/admin tools.
