APP_ENV=development
CORE_ADDR=127.0.0.1:8081
CORE_INTERNAL_TOKEN=replace-in-production
CORE_PUBLIC_URL=http://127.0.0.1:8081
# Core 内部声音广播/主线测试音频，不再依赖独立 audio-service。
CORE_AUDIO_TEST_WAV_PATH=E:\直播伴播\测试素材\母带时间轴测试\mainline_same_tts.wav

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=livecompanion
DB_USER=livecompanion
DB_PASSWORD=change-me

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

STORAGE_DRIVER=local
MEDIA_ROOT=./data/media
MEDIA_CACHE_ROOT=./data/cache/media
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Legacy audio root remains supported while old local assets are migrated.
AUDIO_ROOT=./data/audio

LLM_PROVIDER=qwen
LLM_API_KEY=

TTS_PROVIDER=qwen
TTS_API_KEY=

FFMPEG_PATH=ffmpeg
# Douyin Browser Collector
# Leave path empty to auto-detect Chrome/Chromium/Edge.
COLLECTOR_BROWSER_PATH=
COLLECTOR_BROWSER_HEADLESS=true
# Browser collector runtime
# Leave blank for auto-detection.
COLLECTOR_NODE_PATH=
COLLECTOR_WORKER_PATH=
