APP_ENV=development
MGMT_ADDR=127.0.0.1:8080

CORE_BASE_URL=http://127.0.0.1:8081
CORE_INTERNAL_TOKEN=replace-in-production

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=livecompanion
DB_USER=livecompanion
DB_PASSWORD=change-me

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
MGMT_AUDIT_LOG_LIMIT=10000

# Avatar files are stored outside MySQL. Use a writable cross-platform path.
MGMT_AVATAR_DIR=data/avatars

# User media / voice-clone samples.
# Keep "local" for development. Switch to "oss" after Alibaba Cloud OSS is configured.
STORAGE_DRIVER=local
MEDIA_ROOT=data/media
OSS_ENDPOINT=
OSS_PUBLIC_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_URL_EXPIRY_SECONDS=900

DEV_TENANT_CODE=demo
DEV_TENANT_NAME=演示客户
