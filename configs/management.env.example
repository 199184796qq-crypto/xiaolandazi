APP_ENV=development
MGMT_ADDR=127.0.0.1:8080
# Keep true for HTTPS production. Set false only for temporary HTTP/IP testing.
AUTH_COOKIE_SECURE=

CORE_BASE_URL=http://127.0.0.1:8081
CORE_INTERNAL_TOKEN=replace-in-production

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=livecompanion
DB_USER=livecompanion
DB_PASSWORD=change-me

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
MGMT_AUDIT_LOG_LIMIT=10000

# Avatar files are stored outside MySQL. Use a writable cross-platform path.
MGMT_AVATAR_DIR=data/avatars

# User media / voice-clone samples.
# Keep "local" for development. Switch to "oss" after Alibaba Cloud OSS is configured.
STORAGE_DRIVER=local
MEDIA_ROOT=data/media
OSS_ENDPOINT=
OSS_PUBLIC_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_URL_EXPIRY_SECONDS=900

# Alibaba Cloud Model Studio. The same DashScope API key is reused by the
# existing Qwen Agent and the long-file ASR speech-analysis pipeline.
DASHSCOPE_API_KEY=
DASHSCOPE_ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_ASR_MODEL=qwen-audio-3.1-asr-flash-filetrans

# Optional disposable acoustic greeting cue (not voiceprint identity).
# Empty disables auto analysis; explicit per-device preferences still work.
# Official model: https://help.aliyun.com/zh/model-studio/qwen-omni
DEVICE_ADDRESSING_MODEL=
# For a workspace-specific API Host: https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DEVICE_ADDRESSING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Ogg is decoded to 16k mono WAV in memory; entire analysis is bounded to 3s.
DEVICE_ADDRESSING_FFMPEG=ffmpeg

# Semantic retrieval / embedding. Disabled by default for staged rollout.
SEMANTIC_ENABLED=false
SEMANTIC_TIMEOUT_MS=1200
SEMANTIC_BATCH_SIZE=20
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# Prefer the workspace-specific Model Studio API Host when available.
DASHSCOPE_EMBEDDING_BASE_URL=

DEV_TENANT_CODE=demo
# Optional operator-owned model routing; empty keeps the current Qwen default.
# Switching analysis does not re-analyze already saved anchor-delivery/v1 rules.
ANCHOR_ANALYSIS_PROVIDER=
ANCHOR_ANALYSIS_MODEL=
ANCHOR_GENERATION_PROVIDER=
ANCHOR_GENERATION_MODEL=
# Declarative anchor-style plugin manifests. Production releases include this
# directory under /opt/xiaolan/current; trusted executors stay compiled in Go.
ANCHOR_STYLE_PLUGIN_DIR=/opt/xiaolan/current/plugins/anchor-style
# Optional OpenAI-compatible chat/completions endpoint (server-side credentials).
# Non-compatible vendors need a Provider adapter, not a new style schema.
AGENT_COMPATIBLE_BASE_URL=
AGENT_COMPATIBLE_API_KEY=
# Encrypt administrator-configured speech model API keys; use a random server-only
# value of at least 32 characters. Back up securely; changing it requires key re-entry.
MODEL_CONFIG_ENCRYPTION_KEY=
DEV_TENANT_NAME=演示客户
## Must match the Xiaozhi gateway token. Empty disables device claiming.
XIAOZHI_INTERNAL_TOKEN=""

# WeChat JSAPI payment. Keep disabled until merchant setup and credentials are ready.
# These two identifiers are public; all credentials below stay server-side.
WECHAT_PAY_ENABLED=false
WECHAT_PAY_APP_ID=wx5a19fd75c13d5584
WECHAT_PAY_MCH_ID=1118326239
WECHAT_PAY_MERCHANT_CERT_SERIAL_NO=
WECHAT_PAY_MERCHANT_PRIVATE_KEY_PATH=
WECHAT_PAY_API_V3_KEY=
WECHAT_OFFICIAL_ACCOUNT_APP_SECRET=
# Recommended: download WeChat Pay public key from the merchant platform.
# Leaving both empty uses the legacy platform certificate downloader.
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=https://www.xiaolandaizi.cn/api/v1/payments/wechat/notify
WECHAT_PAY_OAUTH_CALLBACK_URL=https://www.xiaolandaizi.cn/api/v1/payments/wechat/oauth/callback
