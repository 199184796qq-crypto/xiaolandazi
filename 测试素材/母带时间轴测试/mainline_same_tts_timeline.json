      "char_end": 425,
      "start_ms": 66311,
      "end_ms": 71111,
      "duration_ms": 4800,
      "text": "关于物流这块，我得多啰嗦几句，因为很多外地朋友关心时效。",
      "topics": [
        "delivery"
      ],
      "boundary_prediction_ms": 71111,
      "cut_after_ms": 71111,
      "cut_refined_by_waveform": false,
      "boundary_rms": 0,
      "local_median_rms": 2139.2,
      "safe_score": 96,
      "safe_grade": "A",
      "safe_reason": [
        "same_tts_segment_boundary"
      ],
      "play_start_ms": 66311,
      "play_end_ms": 71111
    },
    {
      "id": "S012",
